npm-debug.log*

# Never commit the bridge pairing secret if it ever ends up under the repo by mistake —
# it's supposed to live outside the repo entirely (see MeetBridge.cs's PluginDataDirectory),
# but this is a deliberate belt-and-suspenders guard.
bridge-secret.txt
